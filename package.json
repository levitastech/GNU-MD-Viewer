{
  "name": "gnu-md-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": "12.8.1"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:js": "pnpm audit",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:compile": "tauri build --no-bundle",
    "desktop:package": "tauri bundle"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.1",
    "dompurify": "3.4.16",
    "highlight.js": "11.12.0",
    "katex": "0.19.0",
    "markdown-it": "15.0.2",
    "mermaid": "12.1.0",
    "svelte": "5.57.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/cli": "2.12.1",
    "@types/node": "24.19.1",
    "eslint": "10.12.0",
    "eslint-plugin-svelte": "3.23.0",
    "prettier": "3.9.9",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
