{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-reader",
  "description": "Accès minimal de la WebView principale aux documents, liens et ressources validés côté Rust.",
  "windows": ["main"],
  "permissions": [
    "allow-select-document",
    "allow-select-root-extension",
    "allow-open-document",
    "allow-select-relative-document",
    "allow-release-document-session",
    "allow-open-external-url",
    "allow-resolve-resource",
    "allow-release-resource-session",
    "allow-poll-document",
    "allow-select-document-reload",
    "allow-load-preferences",
    "allow-save-preferences",
    "allow-clear-recent-documents",
    "allow-forget-recent-document",
    "allow-select-recent-document"
  ]
}
